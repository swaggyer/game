      ]
    },
    "clear_14": {
      "id": "clear_14",
      "kind": "stage_clear",
      "title": "王印殿的石甲守卫",
      "chapter_index": 4,
      "chapter_id": "ruins",
      "stage_index": 14,
      "level_index": 2,
      "level_id": "ruins-03",
      "text": "守卫恢复友善、空间源晶净化，三人成功通过首对星门；村庄的紧急灯讯出现。",
      "path": "res://assets/audio_v13/voice/clear_14.mp3",
      "text_sha256": "559faf99e207ef56434b0dd82994aceb197bb975fcf4867da5972fdcacdb521b",
      "character_count": 35,
      "estimated_duration_seconds": 9.1,
      "sources": [
        "res://data/chapters.json#/chapters/4/levels/2/success"
      ]
    },
    "intro_5": {
      "id": "intro_5",
      "kind": "chapter_intro",
      "title": "终章 · 回家的门，救人的门",
      "chapter_index": 5,
      "chapter_id": "rift",
      "stage_index": 15,
      "text": "四地星脉刚刚相连，吞灯妖便把力量集中到村庄上空，企图吞下整条星脉。三人赶回院落时，小龙已经能够打开回岛的门，却先用这股力量撑起救援通道，让村民撤到安全处。它的星光逐渐变暗，远处却接连亮起熟悉的灯：森林、原野与水乡的伙伴正在回应。星光沿修好的星脉汇来，三人借助一路建立的联系，开始最后一次守界。",
      "path": "res://assets/audio_v13/voice/intro_5.mp3",
      "text_sha256": "688f4cd477c09378895801126e974502a5fc2cff134ad42286b3c55dcda51a03",
      "character_count": 146,
      "estimated_duration_seconds": 35.6,
      "sources": [
        "res://data/chapters.json#/chapters/5/summary"
      ]
    },
    "clear_15": {
      "id": "clear_15",
      "kind": "stage_clear",
      "title": "守灯人的归途",
      "chapter_index": 5,
      "chapter_id": "rift",
      "stage_index": 15,
      "level_index": 0,
      "level_id": "rift-01",
      "text": "三组村民均安全抵达，三盏救援灯持续点亮，院落通道开放。",
      "path": "res://assets/audio_v13/voice/clear_15.mp3",
      "text_sha256": "5f22f839e8f4a30c64fc6eddcd2519f46d6935f185336e6c66443b092d2b6678",
      "character_count": 27,
      "estimated_duration_seconds": 7.2,
      "sources": [
        "res://data/chapters.json#/chapters/5/levels/0/success"
      ]
    },
    "clear_16": {
      "id": "clear_16",
      "kind": "stage_clear",
      "title": "院落里的最后一盏灯",
      "chapter_index": 5,
      "chapter_id": "rift",
      "stage_index": 16,
      "level_index": 1,
      "level_id": "rift-02",
      "text": "四路星光汇入主阵，安全通道稳定，吞灯妖显出形体。",
      "path": "res://assets/audio_v13/voice/clear_16.mp3",
      "text_sha256": "e570b5746b340ccbc0458132d6b742d52b60bd2ebe9a1429d2f05077a73e438b",
      "character_count": 24,
      "estimated_duration_seconds": 6.5,
