      "id": "clear_19",
      "kind": "stage_clear",
      "title": "王座旁的小灯",
      "chapter_index": 6,
      "chapter_id": "island",
      "stage_index": 19,
      "level_index": 1,
      "level_id": "island-02",
      "text": "小龙接过龙王灯，三人的星契纹样在岛上主灯中同时亮起。",
      "path": "res://assets/audio_v13/voice/clear_19.mp3",
      "text_sha256": "cee003eae3fce0f3ca2451f365c6d64643d09ee6c87a660ca53a5674be143ec1",
