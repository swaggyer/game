      ]
    },
    "clear_13": {
      "id": "clear_13",
      "kind": "stage_clear",
      "title": "星图长廊",
      "chapter_index": 4,
      "chapter_id": "ruins",
      "stage_index": 13,
      "level_index": 1,
      "level_id": "ruins-02",
      "text": "三幅星图相连，老龙王与人类伙伴的往事完整呈现，王印殿开放。",
      "path": "res://assets/audio_v13/voice/clear_13.mp3",
      "text_sha256": "58d6e1d1490ad13a11a32c3209b94a2dd05e6a5febe29ff27dbfc0347d535288",
      "character_count": 29,
      "estimated_duration_seconds": 7.7,
