      ]
    },
    "clear_17": {
      "id": "clear_17",
      "kind": "stage_clear",
      "title": "三盏星光的守界之战",
      "chapter_index": 5,
      "chapter_id": "rift",
      "stage_index": 17,
      "level_index": 2,
      "level_id": "rift-03",
      "text": "吞灯妖退回幽影界、裂隙封闭、四地星灯全部亮起，小龙稳定打开通往星灯岛的门。",
      "path": "res://assets/audio_v13/voice/clear_17.mp3",
      "text_sha256": "b4952db32cb87eb7ca381df5270db06cee57835a1f9ff51d07e1d2489b47dbc8",
      "character_count": 37,
      "estimated_duration_seconds": 9.6,
      "sources": [
        "res://data/chapters.json#/chapters/5/levels/2/success"
      ]
    },
    "intro_6": {
      "id": "intro_6",
      "kind": "chapter_intro",
      "title": "尾声 · 接过那盏灯",
      "chapter_index": 6,
      "chapter_id": "island",
      "stage_index": 18,
      "text": "小龙亲自打开星门，带旺仔和小馒头来到星海中的家。长老与龙族居民迎接三位伙伴，王座旁仍放着老龙王曾教小龙点亮的那盏小灯。父亲留下的星光留言让小龙安静地听完最后一句叮嘱；思念没有消失，它也已经能够接过守护的责任。庆典结束后，新龙王在孩子们的院子留下约定之灯，让星灯岛与人间有了一条可以相聚的路。",
      "path": "res://assets/audio_v13/voice/intro_6.mp3",
      "text_sha256": "15d37bfa010af36f86b7974ca37c8e8eb45e1c25c80f74d117143e9cf4d793bf",
      "character_count": 145,
      "estimated_duration_seconds": 35.3,
      "sources": [
        "res://data/chapters.json#/chapters/6/summary"
      ]
    },
    "clear_18": {
      "id": "clear_18",
      "kind": "stage_clear",
      "title": "星海中的第一步",
      "chapter_index": 6,
      "chapter_id": "island",
      "stage_index": 18,
      "level_index": 0,
      "level_id": "island-01",
      "text": "三处景观被记录，龙王灯广场入口出现欢迎星光。",
      "path": "res://assets/audio_v13/voice/clear_18.mp3",
      "text_sha256": "d62c67475d23351c7ec08134f2fde8ed6a5f037c20c22864b04690adc605c98d",
      "character_count": 22,
      "estimated_duration_seconds": 6.0,
